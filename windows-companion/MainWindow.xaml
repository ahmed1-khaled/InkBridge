<Window x:Class="InkBridge.Companion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:InkBridge.Companion"
        Title="InkBridge" Height="820" Width="1240"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="INKBRIDGE" FontSize="27" FontWeight="Bold"/>
                <TextBlock Text="A focused writing surface for your tablet and PC"
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#1B2B40" BorderBrush="#30445F" BorderThickness="1"
                    CornerRadius="18" Padding="16,10" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#F4B860" Margin="0,0,9,0"/>
                    <TextBlock x:Name="ConnectionBadge" Text="STARTING WI-FI…" Foreground="#C7D8EC"
                               FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="18" Padding="20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WI-FI CONNECTION" FontSize="11" FontWeight="Bold" Foreground="#79B7FF"/>
                    <TextBlock Text="Connect your tablet and laptop to the same Wi-Fi network or hotspot."
                               Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12"/>
                    <TextBlock Text="LAPTOP IP ADDRESS" FontSize="10" FontWeight="Bold" Foreground="#91A9C5"/>
                    <TextBlock x:Name="NetworkAddressText" Text="Looking for a Wi-Fi or Ethernet address…"
                               FontSize="15" FontWeight="SemiBold" Margin="0,4,0,10" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="6-DIGIT CONNECTION CODE" FontSize="10" FontWeight="Bold"
                                   Foreground="#91A9C5" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PairingCodeText" Text="------" FontSize="21" FontWeight="Bold"
                                   Foreground="#FFFFFF" Margin="14,0,0,0" FontFamily="Consolas"/>
                        <TextBlock Text="  ·  TCP port 45832" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button x:Name="RestartServerButton" Content="Restart Wi-Fi service"
                            Background="{StaticResource AccentBrush}" Click="RestartServerButton_Click"/>
                    <TextBlock Text="Allow InkBridge on Private networks if Windows Firewall asks."
                               Width="210" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                               FontSize="10" Margin="0,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,16,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LIVE TABLET CANVAS" FontSize="12" FontWeight="Bold" Foreground="#79B7FF"/>
                            <TextBlock x:Name="PreviewStatusText" Text="Waiting for your tablet…" Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1A2A3F" CornerRadius="10" Padding="10,6">
                            <TextBlock Text="PAGE PREVIEW" FontSize="9" FontWeight="Bold" Foreground="#A8C8EB"/>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="#111A27" BorderBrush="#2B3D54" BorderThickness="1"
                            CornerRadius="13" Padding="12">
                        <local:InkCanvasView x:Name="PreviewCanvas"/>
                    </Border>
                    <TextBlock Grid.Row="2" Text="Your paper, PDF page and pen strokes appear here in real time. No full-screen mirror required."
                               Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="3,11,3,0"
                               TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="16" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="PRESENTATION TOOLS" FontSize="11" FontWeight="Bold" Foreground="#79B7FF"/>
                        <TextBlock Text="Use the page preview inside this app, or optionally draw over PowerPoint, PDFs and other desktop apps."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12"/>
                        <WrapPanel>
                            <Button x:Name="ShowOverlayButton" Content="Show desktop overlay" Background="{StaticResource AccentBrush}"
                                    Click="ShowOverlayButton_Click"/>
                            <Button x:Name="HideOverlayButton" Content="Hide overlay" Click="HideOverlayButton_Click"/>
                        </WrapPanel>
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="Undo" Click="UndoButton_Click"/>
                            <Button Content="Redo" Click="RedoButton_Click"/>
                            <Button Content="Clear ink" Click="ClearButton_Click" Margin="0"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="#111A27" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="16" Padding="15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="ACTIVITY" FontSize="11" FontWeight="Bold" Foreground="#79B7FF" Margin="0,0,0,10"/>
                        <TextBox x:Name="LogBox" Grid.Row="1" Background="Transparent" Foreground="#C6D2E1"
                                 BorderThickness="0" IsReadOnly="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"/>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="2" Margin="2,12,2,0">
                    <TextBlock Text="InkBridge 0.3 · Local Wi-Fi · Live page preview"
                               Foreground="{StaticResource MutedBrush}" FontSize="10" DockPanel.Dock="Left"/>
                    <Button Content="Check updates" DockPanel.Dock="Right" Padding="10,5" FontSize="10"
                            Click="CheckUpdatesButton_Click" Margin="0"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
