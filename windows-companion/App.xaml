<Application x:Class="InkBridge.Companion.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#101722" />
        <SolidColorBrush x:Key="PanelBrush" Color="#182333" />
        <SolidColorBrush x:Key="AccentBrush" Color="#3B91F5" />
        <SolidColorBrush x:Key="TextBrush" Color="#F4F7FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#9AAAC0" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F4F7FB" />
            <Setter Property="Background" Value="#2A3A50" />
            <Setter Property="BorderBrush" Value="#3B4E66" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,9" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Background" Value="#F7F9FC" />
            <Setter Property="Foreground" Value="#17202C" />
        </Style>
    </Application.Resources>
</Application>
